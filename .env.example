# "ollama" 또는 "claude"로 전환
PROVIDER=ollama

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Claude 설정
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# 온도 설정
TEMPERATURE_CHAT=0.7
TEMPERATURE_STRUCTURED=0.1

# STT 제공자: "local" (faster-whisper) 또는 "openai"
STT_PROVIDER=local

# OpenAI Whisper API 설정 (STT_PROVIDER=openai 일 때 사용)
OPENAI_API_KEY=your-openai-api-key-here

# RAG (Pinecone + Upstage)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_VOCA_INDEX=voca-index
UPSTAGE_API_KEY=your-upstage-api-key-here
UPSTAGE_EMBEDDING_MODEL=solar-embedding-1-large
